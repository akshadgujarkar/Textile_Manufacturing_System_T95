# Everest Textile Manufacturing System - Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control.

# Server
NODE_ENV=development
PORT=3000

# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=everest_tms
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Test Database (separate from dev/production)
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=your_db_password
TEST_DB_NAME=everest_tms_test

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
