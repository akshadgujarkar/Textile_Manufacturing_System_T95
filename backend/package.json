{
  "name": "everest-textile-tms-backend",
  "version": "1.0.0",
  "description": "Production Backend Architecture for Everest Textile Manufacturing System",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "ts-node tests/phase3_runtime.test.ts",
    "test:phase4": "ts-node tests/phase4_raw_materials.test.ts",
    "test:phase5": "ts-node tests/phase5_orders.test.ts",
    "test:phase6": "ts-node tests/phase6_production.test.ts",
    "test:phase7": "ts-node tests/phase7_quality.test.ts",
    "test:phase8": "ts-node tests/phase8_dispatch.test.ts",
    "test:phase9": "ts-node tests/phase9_finance.test.ts",
    "test:phase10": "ts-node tests/phase10_costing.test.ts",
    "test:phase11": "ts-node tests/phase11_admin.test.ts",
    "migrate:phase1": "psql -d textile_db -f database/init_phase1.sql",
    "migrate:phase2": "psql -d textile_db -f database/init_phase2.sql",
    "verify:db": "psql -d textile_db -f database/verify_phase2.sql"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED"
}
